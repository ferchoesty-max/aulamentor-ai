rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }
    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }
    function isTeacher() {
      return isAuthenticated() && (getUserRole() == 'teacher' || getUserRole() == 'admin');
    }
    function isStudent() {
      return isAuthenticated() && getUserRole() == 'student';
    }
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && (request.auth.uid == userId || getUserRole() == 'admin');
    }
    match /courses/{courseId} {
      allow read: if isAuthenticated();
      allow write: if isTeacher();
    }
    match /questions/{questionId} {
      allow read, write: if isTeacher();
    }
    match /enrollments/{enrollmentId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }
    match /attempts/{attemptId} {
      allow read: if isAuthenticated();
      allow create: if isStudent();
      allow update, delete: if isTeacher();
    }
    match /masteryProfiles/{profileId} {
      allow read: if isAuthenticated();
      allow write: if isTeacher() || isAuthenticated();
    }
    match /recommendations/{recommendationId} {
      allow read, update: if isAuthenticated();
      allow create, delete: if isTeacher();
    }
  }
}
