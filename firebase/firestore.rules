rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function profile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasRole(role) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && profile().role == role;
    }

    function isAdmin() {
      return hasRole('admin');
    }

    function isCourseTeacher(courseId) {
      return hasRole('teacher')
        && get(/databases/$(database)/documents/courses/$(courseId)).data.teacher_uid == request.auth.uid;
    }

    // Cada quien lee solo su propio perfil, el admin puede leer todos
    match /users/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isAdmin());
      allow write: if false;
    }

    // Docente dueño y admin leen su curso, el estudiante solo ve cursos activos del catálogo
    match /courses/{courseId} {
      allow read: if isSignedIn()
        && (isAdmin() || isCourseTeacher(courseId) || (hasRole('student') && resource.data.status == 'active'));
      allow write: if false;
    }

    match /questions/{questionId} {
      allow read: if isSignedIn() && (isAdmin() || isCourseTeacher(resource.data.course_id));
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
